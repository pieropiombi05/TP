# URL del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública) del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL base de la aplicación (usada para armar las URLs de retorno de MercadoPago).
NEXT_PUBLIC_APP_URL=https://tp-blond.vercel.app

# Access token de MercadoPago. Es una credencial de Mercado Pago: nunca debe commitearse.
MP_ACCESS_TOKEN=

# Lista de emails admin, separados por coma (ej: a@womboo.com,b@womboo.com).
ADMIN_EMAILS=

# Clave de service role de Supabase. Secreta: solo se usa en el servidor, nunca debe commitearse.
SUPABASE_SERVICE_ROLE_KEY=
